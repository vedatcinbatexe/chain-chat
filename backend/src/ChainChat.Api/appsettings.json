{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=chainchat;Username=chainchat;Password=chainchat"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Chain": {
    "Network": "anvil",
    "ChainId": 31337,
    "RpcUrls": [
      "http://localhost:8545"
    ],
    "DeploymentsPath": "../../../shared/deployments",
    "MaxRetriesPerEndpoint": 2,
    "RequestTimeoutSeconds": 10
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "Auth": {
    "Domain": "chainchat.local",
    "Uri": "chainchat://app",
    "Statement": "Sign in to ChainChat with your wallet.",
    "JwtSigningKey": "",
    "Issuer": "chainchat-api",
    "Audience": "chainchat-app",
    "TokenLifetimeMinutes": 60,
    "NonceLifetimeMinutes": 5,
    "MaxMessageLifetimeMinutes": 10,
    "ClockSkewMinutes": 2
  },
  "Admin": {
    "Addresses": [],
    "Domain": "localhost:5173",
    "Uri": "http://localhost:5173",
    "Statement": "Sign in to the ChainChat admin dashboard.",
    "FunderPrivateKey": "",
    "MaxFundEth": 10,
    "MaxFundChat": 100000
  },
  "GasDrip": {
    "Enabled": false,
    "PrivateKey": "",
    "AmountEth": 0.05
  },
  "Indexer": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "Confirmations": 2,
    "BatchSize": 2000
  },
  "Anchoring": {
    "Enabled": false,
    "IntervalSeconds": 300,
    "SettleSeconds": 5,
    "MaxBatchSize": 1000,
    "ReceiptTimeoutSeconds": 120,
    "PrivateKey": ""
  },
  "Payments": {
    "PollIntervalSeconds": 3,
    "Confirmations": 2,
    "GiveUpAfterMinutes": 5
  }
}
