# Copy to .env and adjust if needed: cp .env.example .env
# Local development values only — do not reuse for any shared environment.

POSTGRES_DB=chainchat
POSTGRES_USER=chainchat
POSTGRES_PASSWORD=chainchat
POSTGRES_PORT=5432

ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
ANVIL_BLOCK_TIME=2
ANVIL_ACCOUNTS=20

API_PORT=5080

# Admin dashboard. If you change it, also set Admin__Domain / Admin__Uri on the API.
DASHBOARD_PORT=5173

# Optional services (docker compose --profile extras up -d)
REDIS_PORT=6379
RABBITMQ_USER=chainchat
RABBITMQ_PASSWORD=chainchat
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
